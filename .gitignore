# Build work: Occultism and Horizon checkouts, Cargo home, logs, screenshots (build.sh, testing)
/.work/
target/

# Packed content mod: rebuilt by build.sh from content/
*.hmod

# The cloud session's export this tree was unpacked from
/occultism-horizon.zip

# The mod package's lock: the launcher resolves its own against the pinned game
/mod/Cargo.lock

# The pinned Horizon SDK, fetched by cargo horizon-mod
/mod/.horizon/

# Packed release files (tools: cargo horizon-mod build)
/dist/

# The Sunrise package, written from mod/ by tools/make_sunrise.py
/mod-sunrise/
